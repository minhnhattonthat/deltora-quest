 },
 {
  "id": "2182_072",
  "hdr": "05810104",
  "jp": "(こ、これは！？)",
  "en": ""
 },
 {
  "id": "2182_073",
  "hdr": "09810208",
  "jp": "リーフ、どうした？",
  "en": ""
 },
 {
  "id": "2182_074",
  "hdr": "02810104",
  "jp": "そうか！！",
  "en": ""
 },
 {
  "id": "2182_075",
  "hdr": "00000501",
  "jp": "トパーズは{sp}それを身につける者の{n}精神を強め{sp}やみから守る{n}{n}心の目をきよめ{sp}しんじつを見せる石",
  "en": ""
 },
 {
  "id": "2182_076",
  "hdr": "02810104",
  "jp": "ぼくたちが見ていたのは{n}まぼろしだったんだ！{p}トパーズが{sp}しんじつを{n}見せてくれたんだ！{p}ジャスミン、きみのカンは{n}正しかった！",
  "en": ""
 },
 {
  "id": "2182_077",
  "hdr": "0D810208",
  "jp": "トパーズが何を見せただと？",
  "en": ""
 },
 {
  "id": "2182_078",
  "hdr": "02810104",
  "jp": "ここは{sp}いごこちのいい部屋{n}なんかじゃない{p}気味の悪い{sp}かいぶつのすみかだ",
  "en": ""
 },
 {
  "id": "2182_079",
  "hdr": "0B810208",
  "jp": "なんと……",
  "en": ""
 },
 {
  "id": "2182_080",
  "hdr": "1281030C",
  "jp": "にげましょう！",
  "en": ""
 },
 {
  "id": "2182_081",
  "hdr": "02030104",
  "jp": "待って！{sp}トパーズの力を！",
  "en": ""
 },
 {
  "id": "2182_082",
  "hdr": "0A030208",
  "jp": "どうすりゃいいんだ！",
  "en": ""
 },
 {
  "id": "2182_083",
  "hdr": "00000000",
  "jp": "『しんじつにむかってとびたて』",
  "en": ""
 },
 {
  "id": "2182_084",
  "hdr": "00000000",
  "jp": "とび石{n}{n}近くの石をタッチすると{n}ジャンプするぞ{n}『しんじつにむかってとびたて』",
  "en": ""
 },
 {
  "id": "2182_085",
  "hdr": "2801099C",
  "jp": "くっそう！{sp}にげる気だ！",
  "en": ""
 },
 {
  "id": "2182_086",
  "hdr": "280106A0",
  "jp": "せっかく生肉が食えると{n}思ったのに",
  "en": ""
 },
 {
  "id": "2182_087",
  "hdr": "2801099C",
  "jp": "まだ{sp}おそくはないさ。{n}つかまえて食っちまおう！",
  "en": ""
 },
 {
  "id": "2182_088",
  "hdr": "09810208",
  "jp": "なんだ、あのかいぶつは……",
  "en": ""
 },
 {
  "id": "2182_089",
  "hdr": "02810104",
  "jp": "あれが{sp}しんせつなふたりの正体！{p}あいつら、ぼくたちを{n}食べる気だったんだ！",
  "en": ""
 },
 {
  "id": "2182_090",
  "hdr": "1302030C",
  "jp": "うっ！",
  "en": ""
 },
 {
  "id": "2182_091",
  "hdr": "02810104",
  "jp": "ジャスミン！！",
  "en": ""
 },
 {
  "id": "2182_092",
  "hdr": "280106A0",
  "jp": "ヒャッヒャッヒャッヒャッ！",
  "en": ""
 },
 {
  "id": "2182_093",
  "hdr": "0A810208",
  "jp": "来るぞ！",
  "en": ""
 },
 {
  "id": "2182_094",
  "hdr": "02810104",
  "jp": "あいつらは{sp}まかせて！{n}バルダはジャスミンを！",
  "en": ""
 },
 {
  "id": "2182_095",
  "hdr": "2801099C",
  "jp": "なんってこった！",
  "en": ""
 },
 {
  "id": "2182_096",
  "hdr": "280106A0",
  "jp": "もうすこしで肉が食えたのに！",
  "en": ""
 },
 {
  "id": "2182_097",
  "hdr": "01810104",
  "jp": "いいぞ、クリー！",
  "en": ""
 },
 {
  "id": "2182_098",
  "hdr": "0A030208",
  "jp": "くっ、ぬまのドロが重くてかなわん",
