 },
 {
  "id": "2182_069",
  "hdr": "03810104",
  "jp": "べつに……",
  "en": ""
 },
 {
  "id": "2182_070",
  "hdr": "1281030C",
  "jp": "ベルトは？",
  "en": ""
 },
 {
  "id": "2182_071",
  "hdr": "03810104",
  "jp": "だいじょうぶ、ベルトもあるし{n}トパーズも無事に……",
