 },
 {
  "id": "2182_100",
  "hdr": "1381030C",
  "jp": "ふぅ……あぶなかった",
  "en": ""
 },
 {
  "id": "2182_101",
  "hdr": "04810104",
  "jp": "ありがとう、助かったよ。{n}ねえ、きみの名前は？",
  "en": ""
 },
 {
  "id": "2182_102",
  "hdr": "0B810208",
  "jp": "リーフ……{n}ララド族はしゃべれないんだ",
  "en": ""
 },
 {
  "id": "2182_103",
  "hdr": "00000500",
  "jp": "ぼくは知りませんでした。{n}ララド族は{sp}まじょテーガンに声を{n}うばわれてしまったんですね。",
  "en": ""
 },
 {
  "id": "2182_104",
  "hdr": "00000500",
  "jp": "でも、そのララド族は地面に{n}文字を書いて教えてくれました。{n}彼の名前はマナス。",
  "en": ""
 },
 {
  "id": "2182_105",
  "hdr": "00000500",
  "jp": "マナスは5年もの長いあいだ{n}まじょテーガンの手下{n}『ジニとジッド』に{sp}ドレイとして{n}こきつかわれていたそうです。{n}{n}やっとの思いで{sp}にげ出したのに{n}今度は{sp}影の憲兵団に{n}つかまってしまったそうで……",
  "en": ""
 },
 {
  "id": "2182_106",
  "hdr": "00000500",
  "jp": "だから、助けたぼくたちに{sp}大げさなくらい{n}おれいをしてくれました。{n}{n}そして、ララド族のこきょう{sp}ララディンに{n}しょうたいしてくれたんです。",
  "en": ""
 },
 {
  "id": "2182_107",
  "hdr": "01030104",
  "jp": "ここが……ララディン？",
  "en": ""
 },
 {
  "id": "2182_108",
  "hdr": "1103030C",
  "jp": "だれも住んでいないの？",
  "en": ""
 },
 {
  "id": "2182_109",
  "hdr": "09030208",
  "jp": "見ろ……あの家のとびらを",
  "en": ""
 },
 {
  "id": "2182_110",
  "hdr": "1703030C",
  "jp": "影の大王のしるしよ",
  "en": ""
 },
 {
  "id": "2182_111",
  "hdr": "0B030208",
  "jp": "どうやらここは影の大王に{n}ほろぼされてしまったようだな",
  "en": ""
 },
 {
  "id": "2182_112",
  "hdr": "03030104",
  "jp": "そんな……",
  "en": ""
 },
 {
  "id": "2182_113",
  "hdr": "1303030C",
  "jp": "マナスが{sp}ふいているんだわ……",
  "en": ""
 },
 {
  "id": "2182_114",
  "hdr": "03810104",
  "jp": "(なんて恋しい音色なんだ……)",
  "en": ""
 },
 {
  "id": "2182_115",
  "hdr": "1403030C",
  "jp": "見て！{sp}ララド族が{n}おおぜい出てきた！",
  "en": ""
 },
 {
  "id": "2182_116",
  "hdr": "0C030208",
  "jp": "そうか！！{sp}わははは！{p}ララド族は地下にかくれていたんだ{p}さすが大工のしゅぞく！{p}おそらく地下に{sp}りっぱな町を{n}つくったんだろうよ",
  "en": ""
 },
 {
  "id": "2182_117",
  "hdr": "00000500",
  "jp": "マナスの命のおんじんという事で{n}ぼくたちは{sp}とても{sp}かんげいされました。{n}{n}バルダが{sp}よそうしたとおりの{sp}町が{n}地下にありました。{n}{n}おいしい料理をたくさん食べて{n}ひさしぶりに{sp}ぐっすり{sp}ねむりました。",
  "en": ""
 },
 {
  "id": "2182_118",
  "hdr": "00000500",
  "jp": "あまり{sp}いごこちがいいので{n}ぼくたちは{sp}何日ものあいだ{n}ララディンですごしました。{n}{n}バルダが怒りださなかったら{n}もっといたかもしれません。{n}父さん。{n}バルダをぼくにつけたのは{sp}せいかいです。",
  "en": ""
 },
 {
  "id": "2182_119",
  "hdr": "09810208",
  "jp": "さあ、マナス。{n}もう帰っていいぞ",
  "en": ""
 },
 {
  "id": "2182_120",
  "hdr": "0D810208",
  "jp": "わたしの命はあなたの物、だと？",
  "en": ""
 },
 {
  "id": "2182_121",
  "hdr": "01810104",
  "jp": "ありがとう。{n}でも、もうじゅうぶんだよ",
  "en": ""
 },
 {
  "id": "2182_122",
  "hdr": "09810208",
  "jp": "ソルディーン？",
  "en": ""
 },
 {
  "id": "2182_123",
  "hdr": "01810104",
  "jp": "それはなに？",
  "en": ""
 },
 {
  "id": "2182_124",
  "hdr": "1281030C",
  "jp": "何か来るわよ！",
  "en": ""
 },
 {
  "id": "2182_125",
  "hdr": "05810104",
  "jp": "(これがソルディーンなんだな……)",
  "en": ""
 },
 {
  "id": "2182_126",
  "hdr": "1281030C",
