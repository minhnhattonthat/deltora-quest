 },
 {
  "id": "2182_041",
  "hdr": "0A810208",
  "jp": "そういう事だ{n}さあ、行くぞ！",
  "en": ""
 },
 {
  "id": "2182_042",
  "hdr": "02810104",
  "jp": "ちょっと待ってよ！",
  "en": ""
 },
 {
  "id": "2182_043",
  "hdr": "0D030208",
  "jp": "うわ！",
  "en": ""
 },
 {
  "id": "2182_044",
  "hdr": "0A030208",
  "jp": "来るな！{n}ここは底なしぬまだ！",
  "en": ""
 },
 {
  "id": "2182_045",
  "hdr": "0A030208",
  "jp": "オレの事は{sp}ほうっておけ！",
  "en": ""
 },
 {
  "id": "2182_046",
  "hdr": "02810104",
  "jp": "なに言ってるんだ！",
  "en": ""
 },
 {
  "id": "2182_047",
  "hdr": "1703030C",
  "jp": "あ！",
  "en": ""
 },
 {
  "id": "2182_048",
  "hdr": "02810104",
  "jp": "ダメだ！",
  "en": ""
 },
 {
  "id": "2182_049",
  "hdr": "0B030208",
  "jp": "リーフ、にげ……",
  "en": ""
 },
 {
  "id": "2182_050",
  "hdr": "1203030C",
  "jp": "クリー！{sp}フィリ！",
  "en": ""
 },
 {
  "id": "2182_051",
  "hdr": "03810104",
  "jp": "ああ……父さん！{sp}母さん！",
  "en": ""
 },
 {
  "id": "2182_052",
  "hdr": "03810104",
  "jp": "(……ここはどこだ？)",
  "en": ""
 },
 {
  "id": "2182_053",
  "hdr": "0B810208",
  "jp": "すまん……{n}オレが{sp}もっと気をつけていれば……",
  "en": ""
 },
 {
  "id": "2182_054",
  "hdr": "1103030C",
  "jp": "この家の人が助けて{n}くれたのかしら？",
  "en": ""
 },
 {
  "id": "2182_055",
  "hdr": "280109A4",
  "jp": "オカソロラシア！",
  "en": ""
 },
 {
  "id": "2182_056",
  "hdr": "280106A8",
  "jp": "カナメキロワ！",
  "en": ""
 },
 {
  "id": "2182_057",
  "hdr": "01810104",
  "jp": "なんて言ってるんだろう",
  "en": ""
 },
 {
  "id": "2182_058",
  "hdr": "09810208",
  "jp": "さあ……聞いた事のない{n}言葉だな{p}しかし{sp}これは{sp}オレたちのために{n}用意してくれたようだぞ",
  "en": ""
 },
 {
  "id": "2182_059",
  "hdr": "01810104",
  "jp": "なんて{sp}しんせつな人たちなんだろう",
  "en": ""
 },
 {
  "id": "2182_060",
  "hdr": "1381030C",
  "jp": "(……いやな予感がする)",
  "en": ""
 },
 {
  "id": "2182_061",
  "hdr": "09810208",
  "jp": "ジャスミン、しつれいだぞ",
  "en": ""
 },
 {
  "id": "2182_062",
  "hdr": "04810104",
  "jp": "助けてくれた上に{n}こんなごちそうまで……{p}本当にありがとうございます",
