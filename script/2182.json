 },
 {
  "id": "2182_139",
  "hdr": "1281030C",
  "jp": "だって！",
  "en": ""
 },
 {
  "id": "2182_140",
  "hdr": "03810104",
  "jp": "(楽しい曲だな……){p}(デルの町にいたころは{n}楽しかったなあ……){p}(あの町はキライだと思ってたけど{n}それでも今よりは楽しかった……)",
