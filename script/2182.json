 },
 {
  "id": "2182_147",
  "hdr": "28010B7C",
  "jp": "笛をやめるな！",
  "en": ""
 },
 {
  "id": "2182_148",
  "hdr": "28010B7C",
  "jp": "おまえらは、なぜ{n}この{sp}きんだんの地へきた？",
