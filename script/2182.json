 },
 {
  "id": "2182_035",
  "hdr": "03810104",
  "jp": "(そうだろうか……)",
  "en": ""
 },
 {
  "id": "2182_036",
  "hdr": "1103030C",
  "jp": "もどって様子を見てくる？",
  "en": ""
 },
 {
  "id": "2182_037",
  "hdr": "0A810208",
  "jp": "だめだ！{p}もう、影の憲兵団が大王に{n}知らせたかもしれない{p}それに{sp}このあたりは{n}まじょテーガンが支配しているはずだ",
  "en": ""
 },
