  "jp": "かくれるんだ！",
  "en": ""
 },
 {
  "id": "2182_176",
  "hdr": "00000000",
  "jp": "ぼくたちが{sp}岩のうしろに{sp}かくれた時{n}そのまじょは{sp}あらわれました。",
