[
 {
  "id": "2182_000",
  "hdr": "00000500",
  "jp": "森で知り合ったジャスミン。{n}ぼくたちは彼女を仲間に入れて{n}『なげきのみずうみ』をめざしました。",
  "en": ""
 },
 {
  "id": "2182_001",
  "hdr": "00000500",
  "jp": "父さん。{n}そのみずうみは、ドールという{n}美しい町だったそうですね。{n}{n}まじょテーガンのまほうで{sp}さびしい{n}みずうみに{sp}かえられてしまったとか。",
  "en": ""
 },
 {
  "id": "2182_002",
  "hdr": "00000500",
  "jp": "うん……でも、ぼくは行きます。{n}そこにデルトラのベルトから{n}うばわれた宝石があるかぎり。",
  "en": ""
 },
 {
  "id": "2182_003",
  "hdr": "0B810208",
  "jp": "このあたりでちょっと休むか",
  "en": ""
 },
 {
  "id": "2182_004",
  "hdr": "02810104",
  "jp": "(もう……おじさんはすぐこれだ)",
  "en": ""
 },
 {
  "id": "2182_005",
  "hdr": "0A030208",
  "jp": "何か言ったか？",
  "en": ""
 },
 {
  "id": "2182_006",
  "hdr": "02810104",
  "jp": "先に進みたいんだけどな",
  "en": ""
 },
 {
  "id": "2182_007",
  "hdr": "1203030C",
  "jp": "シーッ！",
  "en": ""
 },
 {
  "id": "2182_008",
  "hdr": "03810104",
  "jp": "(なんだよ、もう……)",
  "en": ""
 },
 {
  "id": "2182_009",
  "hdr": "1203030C",
  "jp": "てきが近づいてくる！{n}木たちが{sp}さわいでいるでしょ？",
  "en": ""
 },
 {
  "id": "2182_010",
  "hdr": "0B810208",
  "jp": "……わからん",
  "en": ""
 },
 {
  "id": "2182_011",
  "hdr": "1303030C",
  "jp": "てきは影の憲兵団。それもおおぜい",
  "en": ""
 },
 {
  "id": "2182_012",
  "hdr": "1203030C",
  "jp": "ほら、早く！{n}木の上へ！",
  "en": ""
 },
 {
  "id": "2182_013",
  "hdr": "0A030208",
  "jp": "(真下で休んでいやがる……)",
  "en": ""
 },
 {
  "id": "2182_014",
  "hdr": "1203030C",
  "jp": "(もう！)",
  "en": ""
 },
 {
  "id": "2182_015",
  "hdr": "05030104",
  "jp": "(ねえ、見て。あれは{sp}だれ？)",
  "en": ""
 },
 {
  "id": "2182_016",
  "hdr": "09030208",
  "jp": "(ララド族だ){p}(むかしのデルトラ王家が{n}大切にしていた大工の種族){p}(デル城をつくったのはララド族だ)",
  "en": ""
 },
 {
  "id": "2182_017",
  "hdr": "02030104",
  "jp": "(助けよう)",
  "en": ""
 },
 {
  "id": "2182_018",
  "hdr": "1103030C",
  "jp": "(そうね！)",
  "en": ""
 },
 {
  "id": "2182_019",
  "hdr": "09030208",
  "jp": "(いや……めんどうはさけたい)",
  "en": ""
 },
 {
  "id": "2182_020",
  "hdr": "1203030C",
  "jp": "(つめたい{sp}おじさん)",
  "en": ""
 },
 {
  "id": "2182_021",
  "hdr": "0A030208",
  "jp": "(なんとでも言え。{n}オレたちの{sp}もくてきは……)",
  "en": ""
 },
 {
  "id": "2182_022",
  "hdr": "03030104",
  "jp": "(あの人、困っているよ)",
  "en": ""
 },
 {
  "id": "2182_023",
  "hdr": "1203030C",
  "jp": "(見て見ぬふり？)",
  "en": ""
 },
 {
  "id": "2182_024",
  "hdr": "0B030208",
  "jp": "(……好きにしろ)",
  "en": ""
 },
 {
  "id": "2182_025",
  "hdr": "02030104",
  "jp": "する！",
  "en": ""
 },
 {
  "id": "2182_026",
  "hdr": "0B030208",
  "jp": "やれやれ",
  "en": ""
 },
 {
  "id": "2182_027",
  "hdr": "1181030C",
  "jp": "にげて！",
  "en": ""
 },
 {
  "id": "2182_028",
  "hdr": "02810104",
  "jp": "早く！",
  "en": ""
 },
 {
  "id": "2182_029",
  "hdr": "0A810208",
  "jp": "さあ、かかってこい！",
