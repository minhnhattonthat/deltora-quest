[
 {
  "id": "2183_000",
  "hdr": "00000500",
  "jp": "父さん、あぶなかったです。{n}{n}ララド族がとてもよくしてくれたので{n}ぼくたちは{sp}なかなか旅にもどる事が{n}できませんでした。",
  "en": ""
 },
 {
  "id": "2183_001",
  "hdr": "00000500",
  "jp": "でも、少し時間がたってしまったけど{n}なんとかこうして旅にもどりました。{n}{n}次に目指すのは『ラットシティ』です。{n}どんなところなのでしょうか。{n}ララディンのようなところだと{n}いいんだけど……",
  "en": ""
 },
