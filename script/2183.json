 },
 {
  "id": "2183_278",
  "hdr": "28010700",
  "jp": "クリーン•チュルナイ！",
  "en": ""
 },
 {
  "id": "2183_279",
  "hdr": "28010600",
  "jp": "子どもたちは、別室で奠澑をします。{n}聖なる奠澑法をマスターするためです",
