 },
 {
  "id": "2187_046",
  "hdr": "1A030C14",
  "jp": "どういう事？",
  "en": ""
 },
 {
  "id": "2187_047",
  "hdr": "19810710",
  "jp": "大むかし……{p}トーラの住民たちは{sp}永遠のちかいを{n}たてたのだ{p}デルトラ王家に{n}ちゅうせいをつくすという{sp}ちかいだ{p}引きかえに、町の安全と{sp}豊かなくらしを{n}約束するまりょくがあたえられた",
  "en": ""
 },
 {
  "id": "2187_048",
  "hdr": "1A030C14",
