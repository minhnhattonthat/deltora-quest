 },
 {
  "id": "2197_185",
  "hdr": "00000000",
  "jp": "『{c1}{f6}{/c}』で買い物しますか？",
  "en": "Shop at {c1}{f6}{/c}?"
 },
 {
  "id": "2197_186",
  "hdr": "00000000",
  "jp": "キャンプに入りますか？",
  "en": "Enter the camp?"
 },
 {
  "id": "2197_187",
  "hdr": "00000000",
  "jp": "キャンプからでますか？",
  "en": "Leave the camp?"
 },
 {
  "id": "2197_188",
  "hdr": "00000000",
  "jp": "セーブしますか？",
  "en": "Save your game?"
 },
 {
  "id": "2197_189",
  "hdr": "00000000",
  "jp": "セーブしています…{n}でんげんを切ったりカードのぬきさしを{n}しないで下さい",
  "en": "Save in progress...{n}Do not turn off the power{n}or remove the Game Card."
 },
 {
  "id": "2197_190",
  "hdr": "00000000",
  "jp": "セーブがおわりました",
  "en": "Save complete."
 },
 {
  "id": "2197_191",
  "hdr": "00000000",
  "jp": "マドレットに乗って帰りますか？",
  "en": "Ride the muddlet back?"
 },
 {
  "id": "2197_192",
  "hdr": "00000000",
  "jp": "かじをしますか？",
  "en": "Do some smithing?"
 },
 {
  "id": "2197_193",
  "hdr": "05810104",
  "jp": "うわっ{n}まっくらだ",
  "en": "Whoa!{n}It's so dark in here!"
 },
 {
  "id": "2197_194",
  "hdr": "05810104",
  "jp": "これじゃ先にすすめないぞ{p}引きかえそう！",
  "en": "I can't go any further like this.{p}I'd better turn back!"
 },
 {
  "id": "2197_195",
  "hdr": "01810104",
  "jp": "そうだ、これを使おう！",
  "en": "I know, I'll use this!"
 },
 {
  "id": "2197_196",
  "hdr": "00000000",
  "jp": "リーフは{n}『{c2}光のシャボンパイプ{/c}』をふいた",
  "en": "Lief blew the{n}{c2}Bubble Pipe of Light{/c}."
 },
 {
  "id": "2197_197",
  "hdr": "00000000",
  "jp": "{c1}もうもてないよ",
  "en": "{c1}You can't carry any more."
 },
 {
  "id": "2197_198",
  "hdr": "00000000",
  "jp": "{c1}カギがかかっている",
  "en": "{c1}It's locked."
 },
 {
  "id": "2197_199",
  "hdr": "00000000",
  "jp": "『{c2}カギ{/c}』を使った",
  "en": "You used the {c2}Key{/c}."
 },
 {
  "id": "2197_200",
  "hdr": "00000000",
  "jp": "『{c1}グランドファーム{/c}』に{n}行けるようになった！！",
  "en": "You can now go to{n}{c1}the Grand Farm{/c}!!"
 },
 {
  "id": "2197_201",
  "hdr": "00000000",
  "jp": "ぼうけんの{sp}こころえ{n}{n}セーブアイコン:ぼうけんをきろくする{n}リーフたち:キャラクターをえらぶ{n}マドレット:ワールドマップへもどる",
  "en": "Adventure Tips{n}{n}Save icon: Record your adventure{n}Lief's party: Choose a character{n}Muddlet: Return to the World Map"
 },
 {
  "id": "2197_202",
  "hdr": "00000000",
  "jp": "ぼうけんの{sp}こころえ{n}{n}セーブアイコン:ぼうけんをきろくする{n}リーフたち:キャラクターをえらぶ",
  "en": "Adventure Tips{n}{n}Save icon: Record your adventure{n}Lief's party: Choose a character"
 },
 {
  "id": "2197_203",
  "hdr": "00000000",
  "jp": "ぼうけんの{sp}こころえ{n}{n}リーフたち:キャラクターをえらぶ",
  "en": "Adventure Tips{n}{n}Lief's party: Choose a character"
 },
 {
  "id": "2197_204",
  "hdr": "00000000",
  "jp": "ぼうけんの{sp}こころえ{n}{n}リーフたち:キャラクターをえらぶ{n}マドレット:ワールドマップへもどる",
  "en": "Adventure Tips{n}{n}Lief's party: Choose a character{n}Muddlet: Return to the World Map"
 },
 {
  "id": "2197_205",
  "hdr": "09810208",
  "jp": "リーフ、あれを見ろ",
  "en": "Lief, look at that."
 },
 {
  "id": "2197_206",
  "hdr": "01810104",
  "jp": "TOM(トム)って書いてあるね{n}何のお店だろう",
  "en": "It says \"TOM\".{n}I wonder what sort of shop it is."
 },
 {
  "id": "2197_207",
  "hdr": "1181030C",
  "jp": "お店ってなあに？",
  "en": "What's a shop?"
 },
 {
  "id": "2197_208",
  "hdr": "01810104",
  "jp": "(ジャスミンはお店も知らないんだ……)",
  "en": "(Jasmine doesn't even know{n}what a shop is...)"
 },
 {
  "id": "2197_209",
  "hdr": "09810208",
  "jp": "お店っていうのはな……{p}行ってみればわかるだろう",
  "en": "A shop, you see, is...{p}Well, go and look, and you'll find out."
 },
 {
  "id": "2197_210",
  "hdr": "09810208",
  "jp": "これは……やしきのようだな。{n}行ってみるか？",
  "en": "This... looks like a mansion.{n}Shall we go and see?"
 },
 {
  "id": "2197_211",
  "hdr": "01810104",
  "jp": "どうして？",
  "en": "Why?"
 },
 {
  "id": "2197_212",
  "hdr": "09810208",
  "jp": "食べ物とベッドが{sp}あるかもしれん",
  "en": "There might be food and beds."
 },
 {
  "id": "2197_213",
  "hdr": "1181030C",
  "jp": "何言ってるの？{n}旅の{sp}もくてきを忘れたの？",
  "en": "What are you talking about?{n}Have you forgotten why we're travelling?"
 },
 {
  "id": "2197_214",
  "hdr": "0B810208",
  "jp": "オレは、おまえたちが{sp}すこしは{n}休めるようにと……",
  "en": "I only thought you two{n}could get a little rest..."
 },
 {
  "id": "2197_215",
  "hdr": "1181030C",
  "jp": "ねえ、リーフ{p}こんな事{sp}言い出しましたけど",
  "en": "Hey, Lief.{p}Did you hear what he just said?"
 },
 {
  "id": "2197_216",
  "hdr": "01810104",
