[
 {
  "id": "2186_000",
  "hdr": "0A030208",
  "jp": "リーフ！{n}グルーがきたぞ！！{p}にげろ！",
  "en": "Lief!{n}The Glus are coming!!{p}Run!"
 },
 {
  "id": "2186_001",
  "hdr": "01030104",
  "jp": "よし{n}なんとかにげ切ったぞ！",
  "en": "Right!{n}We managed to get away!"
 },
 {
  "id": "2186_002",
  "hdr": "00000100",
  "jp": "画面をたたけ！！",
  "en": "Tap the screen!!"
 },
 {
  "id": "2186_003",
  "hdr": "00000000",
  "jp": "ジャードよ。{n}おまえが影の大王に{sp}つかまったと{n}聞いてから{sp}リーフは心ここにあらずだ。{n}{n}しかし、リーフを{sp}おまえのもとへ{n}帰すつもりはない。{n}それがおまえの望みだと信じている。{n}友よ。未来を見続けてくれ。",
  "en": "Jarred,{n}ever since we heard the Shadow Lord{n}had captured you, Lief's mind{n}has been far away.{n}{n}But I will not send Lief back to you.{n}I believe that is what you would want.{n}My friend, keep looking to the future."
 },
 {
  "id": "2186_004",
  "hdr": "1103030C",
  "jp": "『まもののどうくつ』は本当に{n}こっちでいいの？",
  "en": "Are you sure the Maze of the Beast{n}is really this way?"
 },
 {
  "id": "2186_005",
  "hdr": "09030208",
  "jp": "そのうちトル川に出るはずだ。{n}そして西海岸を目指して下る{p}キンの言葉をうたがう理由は{n}ないだろう",
  "en": "We should reach the River Tor soon.{n}Then we follow it to the west coast.{p}There's no reason to doubt{n}what the Kin told us."
 },
 {
  "id": "2186_006",
  "hdr": "09030208",
  "jp": "なあ、リーフ？",
  "en": "Right, Lief?"
 },
 {
  "id": "2186_007",
  "hdr": "03030104",
  "jp": "……うん",
  "en": "...Yeah."
 },
 {
  "id": "2186_008",
  "hdr": "28010874",
  "jp": "キャッ！{sp}助けて！",
  "en": "Eek! Help!"
 },
 {
  "id": "2186_009",
  "hdr": "28010894",
  "jp": "助けて～！",
  "en": "Help me!"
 },
 {
  "id": "2186_010",
  "hdr": "28010998",
  "jp": "マリーが！{sp}マリーを助けて！",
  "en": "It's Marie! Please, save Marie!"
 },
 {
  "id": "2186_011",
  "hdr": "09030208",
  "jp": "よし、オレが！",
  "en": "Right, leave it to me!"
 },
 {
  "id": "2186_012",
  "hdr": "0D030208",
  "jp": "おい！{sp}どこだ！",
  "en": "Hey! Where are you?"
 },
 {
  "id": "2186_013",
  "hdr": "0D030208",
  "jp": "どこだ！？{sp}見つからんぞ！",
  "en": "Where?! I can't find anyone!"
 },
 {
  "id": "2186_014",
  "hdr": "02030104",
  "jp": "おい、何をする！",
  "en": "Hey, what are you doing?!"
 },
 {
  "id": "2186_015",
  "hdr": "1E810C74",
  "jp": "うわっ！",
  "en": "Argh!"
 },
 {
  "id": "2186_016",
  "hdr": "0A810208",
  "jp": "何者だ！",
  "en": "Who are you?!"
 },
 {
  "id": "2186_017",
  "hdr": "1E810C74",
  "jp": "きみたちを{sp}守ろうとしたんだ！{n}それなのに……グフッ……",
  "en": "I was trying to protect you!{n}And you... Ugh..."
 },
 {
  "id": "2186_018",
  "hdr": "02810104",
  "jp": "ウソをつくな！",
  "en": "Liar!"
 },
 {
  "id": "2186_019",
  "hdr": "1E810C74",
  "jp": "ほら……あれを……",
  "en": "Look... over there..."
 },
 {
  "id": "2186_020",
  "hdr": "1703030C",
  "jp": "キャッ！",
  "en": "Ah!"
 },
 {
  "id": "2186_021",
  "hdr": "1E030C74",
  "jp": "オルだ……気を…つけて……",
  "en": "It's an Ol... Be... careful..."
 },
 {
  "id": "2186_022",
  "hdr": "1E030C74",
  "jp": "……ほら、あれが{sp}オルの正体……",
  "en": "...Look, that's what an Ol{n}really is..."
 },
 {
  "id": "2186_023",
  "hdr": "09030208",
  "jp": "こんな{sp}かいぶつがいるとは……",
  "en": "I never knew such monsters existed..."
 },
 {
  "id": "2186_024",
  "hdr": "1303030C",
  "jp": "わたしたちを助けようと{n}してくれたのね",
  "en": "He was trying{n}to help us."
 },
 {
  "id": "2186_025",
  "hdr": "1103030C",
  "jp": "リーフ、わからなかったの？",
  "en": "Lief, couldn't you tell?"
 },
 {
  "id": "2186_026",
  "hdr": "03030104",
  "jp": "……とっさの事だったから",
  "en": "...It all happened so fast."
 },
 {
  "id": "2186_027",
  "hdr": "1103030C",
  "jp": "それだけじゃないと思うけど？",
  "en": "I don't think that's the only reason."
 },
 {
  "id": "2186_028",
  "hdr": "03030104",
  "jp": "……",
  "en": "..."
 },
 {
  "id": "2186_029",
  "hdr": "1103030C",
  "jp": "お父さんの事で{n}頭がいっぱいなんでしょ？",
  "en": "Your head's full of{n}your father, isn't it?"
 },
 {
  "id": "2186_030",
  "hdr": "1203030C",
  "jp": "気持ちはわかるけど{n}そんなんじゃ旅なんかできないわ！",
  "en": "I understand how you feel, but you{n}can't go on a journey like that!"
 },
 {
  "id": "2186_031",
  "hdr": "03030104",
  "jp": "(そのとおりだ……)",
  "en": "(She's right...)"
 },
 {
  "id": "2186_032",
  "hdr": "01030104",
  "jp": "わかったよ……ぼくは帰る{p}父さんがひどい目にあっているのに{n}旅なんかしていられない",
  "en": "All right... I'm going home.{p}I can't go on a journey{n}while Father is suffering."
 },
 {
  "id": "2186_033",
  "hdr": "0A030208",
  "jp": "そんなかっては{sp}ゆるさない",
  "en": "I won't let you do as you please."
 },
 {
  "id": "2186_034",
  "hdr": "02030104",
  "jp": "ぼくが{sp}きめる事だ！",
  "en": "It's my decision!"
 },
 {
  "id": "2186_035",
  "hdr": "09030208",
  "jp": "オレは……親友の息子を{n}あずかっている",
  "en": "I... was trusted with{n}my dearest friend's son."
 },
 {
  "id": "2186_036",
  "hdr": "02030104",
  "jp": "(親友！？{n}ふん、いそうろうのくせに)",
  "en": "(Dearest friend?!{n}Hmph. You were just a freeloader.)"
 },
 {
  "id": "2186_037",
  "hdr": "0B030208",
  "jp": "オレはジャードの{sp}かくごを知っている{p}リーフ{p}おまえが{sp}旅をやめたのが{n}自分のせいだとジャードが知ったら……",
  "en": "I know what Jarred was ready to give.{p}Lief.{p}If Jarred learned you'd given up{n}the journey because of him..."
 },
 {
  "id": "2186_038",
  "hdr": "03030104",
  "jp": "……",
  "en": "..."
 },
 {
  "id": "2186_039",
  "hdr": "09030208",
  "jp": "よく考えてみるんだな。{n}父親から{sp}たくされた{sp}希望の重さを",
  "en": "Think it over carefully.{n}The weight of the hope{p}your father placed in you."
 },
 {
  "id": "2186_040",
  "hdr": "03030104",
  "jp": "(父さん……重すぎるよ……)",
  "en": "(Father... It's too heavy...)"
 },
 {
  "id": "2186_041",
  "hdr": "09030208",
  "jp": "さあ、ジャスミン。{n}この少年を手厚くほうむってやろう",
  "en": "Now, Jasmine.{n}Let's give this boy a proper burial."
 },
 {
  "id": "2186_042",
  "hdr": "1E030C74",
  "jp": "死んでないって！",
  "en": "I'm not dead!"
 },
 {
  "id": "2186_043",
  "hdr": "20030C74",
  "jp": "いやあ、ひどい目にあったよ",
  "en": "Phew, that was rough."
 },
 {
  "id": "2186_044",
  "hdr": "03030104",
  "jp": "……",
  "en": "..."
 },
 {
  "id": "2186_045",
  "hdr": "1103030C",
  "jp": "リーフ？",
  "en": "Lief?"
 },
 {
  "id": "2186_046",
  "hdr": "03030104",
  "jp": "……ごめん。{n}オルなんて初めてだったから……",
  "en": "...Sorry.{n}I'd never seen an Ol before..."
 },
 {
  "id": "2186_047",
  "hdr": "1A030C74",
  "jp": "じゃあ、おぼえておくんだね{p}オルは影の王国から来たかいぶつ。{n}変身して相手をゆだんさせるんだ",
  "en": "Then you'd better remember this.{p}Ols are monsters from the Shadowlands.{n}They change shape to trick you."
 },
 {
  "id": "2186_048",
  "hdr": "1103030C",
  "jp": "くわしいのね",
  "en": "You know a lot about them."
 },
 {
  "id": "2186_049",
  "hdr": "1A030C74",
  "jp": "ジョーカーから聞いたんだ{p}レジスタンスのジョーカーは{n}知ってるよね？",
  "en": "Doom told me.{p}You know Doom of the Resistance,{n}right?"
 },
 {
  "id": "2186_050",
  "hdr": "1203030C",
  "jp": "ジョーカー……",
  "en": "Doom..."
 },
 {
  "id": "2186_051",
  "hdr": "20030C74",
  "jp": "気に入らないって顔だね。{n}実はぼくもさ",
  "en": "You don't look like you like him.{n}Actually, neither do I."
 },
 {
  "id": "2186_052",
  "hdr": "1A030C74",
  "jp": "ジョーカーとは{n}ケンカ別れしてきたんだ",
  "en": "Doom and I had a fight,{n}and I left."
 },
 {
  "id": "2186_053",
  "hdr": "09030208",
  "jp": "おまえはいったい{sp}だれだ？",
  "en": "Just who are you?"
 },
 {
  "id": "2186_054",
  "hdr": "1A030C14",
  "jp": "ぼくはデイン{p}レジスタンスの一員で……{n}デルトラ王家の{sp}あとつぎさ",
  "en": "I'm Dain.{p}A member of the Resistance...{n}and heir to the royal house of Deltora."
 },
 {
  "id": "2186_055",
  "hdr": "05030104",
  "jp": "なんだって！？",
  "en": "What?!"
 },
 {
  "id": "2186_056",
  "hdr": "1F030C14",
  "jp": "……だれも信じてくれないけど",
  "en": "...Not that anyone believes me."
 },
 {
  "id": "2186_057",
  "hdr": "01030104",
  "jp": "……",
  "en": "..."
 },
 {
  "id": "2186_058",
  "hdr": "1103030C",
  "jp": "……",
  "en": ""
 },
 {
  "id": "2186_059",
  "hdr": "09030208",
  "jp": "……",
  "en": ""
 },
 {
  "id": "2186_060",
  "hdr": "1A030C14",
  "jp": "ほらね{n}でも、養父母がそう言ったんだ{p}ぼくだけでも信じないとね",
  "en": ""
 },
 {
  "id": "2186_061",
  "hdr": "09030208",
  "jp": "養父母と言ったな。{n}では本当の両親はどうした？{p}つまり王と妃(きさき)という事だが？",
  "en": ""
 },
 {
  "id": "2186_062",
  "hdr": "1A030C14",
  "jp": "ぼくがまだ幼いころ……{p}養父母に{sp}ぼくを{sp}あずけて{n}どこかへ行ってしまったんだ",
  "en": ""
 },
 {
  "id": "2186_063",
  "hdr": "09030208",
  "jp": "……すぐに信じろと言われても{n}無理な話だな{p}では、育ての親はどこにいる？{n}くわしい話を聞きたい",
  "en": ""
 },
 {
  "id": "2186_064",
  "hdr": "1A030C14",
  "jp": "死んだよ。オルにやられてね{p}養父母をなくして、ぼくは{n}レジスタンスに入ったんだ",
  "en": ""
 },
 {
  "id": "2186_065",
  "hdr": "1103030C",
  "jp": "ここで何をしていたの？",
  "en": ""
 },
 {
  "id": "2186_066",
  "hdr": "1A030C14",
  "jp": "トーラへの旅のとちゅうさ",
  "en": ""
 },
 {
  "id": "2186_067",
  "hdr": "0D030208",
  "jp": "トーラだと！？",
  "en": ""
 },
 {
  "id": "2186_068",
  "hdr": "1A030C14",
  "jp": "うん、ぼくはそろそろ{n}行かなくちゃ{p}みんなも気をつけて",
  "en": ""
 },
 {
  "id": "2186_069",
  "hdr": "01030104",
  "jp": "王家のあとつぎ？{n}しょうこが{sp}ないのに信じろって？",
  "en": ""
 },
 {
  "id": "2186_070",
  "hdr": "09030208",
  "jp": "リーフの言うとおりだ{p}しかし、トーラは{sp}オレたちの{n}とおり道にある{p}様子をさぐりながら{n}いっしょに{sp}行くというのはどうだ？",
  "en": ""
 },
 {
  "id": "2186_071",
  "hdr": "1103030C",
  "jp": "トーラって？",
  "en": ""
 },
 {
  "id": "2186_072",
  "hdr": "09030208",
  "jp": "大むかしからデルトラ王家に{n}ちゅうじつな{sp}町だ{p}王家のあとつぎを名乗る少年が{n}そこへ行きたいというのが気になる",
  "en": ""
 },
 {
  "id": "2186_073",
  "hdr": "1103030C",
  "jp": "デインが本物かどうかより、ケガを{n}させてしまった事が{sp}気になるわ{p}命のおんじんなのに。{n}ね、リーフ？",
  "en": ""
 },
 {
  "id": "2186_074",
  "hdr": "03030104",
  "jp": "うん……",
  "en": ""
 },
 {
  "id": "2186_075",
  "hdr": "09030208",
  "jp": "もしデインが本物のあとつぎで……{p}しかも、リーフが早とちりで負わせた{n}ケガのせいで{sp}もしもの事があったら……",
  "en": ""
 },
 {
  "id": "2186_076",
  "hdr": "1103030C",
  "jp": "ねえ、リーフ！",
  "en": ""
 },
 {
  "id": "2186_077",
  "hdr": "09030108",
  "jp": "ジャードはどう思うだろうな……",
  "en": ""
 },
 {
  "id": "2186_078",
  "hdr": "02030104",
  "jp": "わかってるよ！",
  "en": ""
 },
 {
  "id": "2186_079",
  "hdr": "01030104",
  "jp": "もし……もし本物だったら{n}父さんに合わせる顔がない",
  "en": ""
 },
 {
  "id": "2186_080",
  "hdr": "01030104",
  "jp": "(父さん、これでいいんだよね？)",
  "en": ""
 },
 {
  "id": "2186_081",
  "hdr": "01030104",
  "jp": "さあ、デインを{sp}おいかけよう",
  "en": ""
 },
 {
  "id": "2186_082",
  "hdr": "1103030C",
  "jp": "リーフ、ふっかつかな？",
  "en": ""
 },
 {
  "id": "2186_083",
  "hdr": "09030108",
  "jp": "そうあってほしいものだな",
  "en": ""
 },
 {
  "id": "2186_084",
  "hdr": "05010104",
  "jp": "デイン！",
  "en": ""
 },
 {
  "id": "2186_085",
  "hdr": "01030104",
  "jp": "だいじょうぶかい？",
  "en": ""
 },
 {
  "id": "2186_086",
  "hdr": "1A810C14",
  "jp": "きみにやられたケガが……",
  "en": ""
 },
 {
  "id": "2186_087",
  "hdr": "03030104",
  "jp": "本当に、ごめん……",
  "en": ""
 },
 {
  "id": "2186_088",
  "hdr": "09030208",
  "jp": "せめてもの{sp}つぐないだ。{n}トーラまで{sp}おくらせてもらおう",
  "en": ""
 },
 {
  "id": "2186_089",
  "hdr": "1A810C14",
  "jp": "それはどうかな。{n}あなたたちと{sp}いっしょだと……",
  "en": ""
 },
 {
  "id": "2186_090",
  "hdr": "1203030C",
  "jp": "なによ！",
  "en": ""
 },
 {
  "id": "2186_091",
  "hdr": "1A810C14",
  "jp": "あなたたちは{n}影の大王に{sp}おわれている3人組だろ？",
  "en": ""
 },
 {
  "id": "2186_092",
  "hdr": "09030208",
  "jp": "オレたちは{sp}ただの旅人さ",
  "en": ""
 },
 {
  "id": "2186_093",
  "hdr": "1A810C14",
  "jp": "まあ、そう言うしか{n}ないと思うけど……{p}どちらにしても、あなたたちとは{n}いたくないんだ",
  "en": ""
 },
 {
  "id": "2186_094",
  "hdr": "1A810C14",
  "jp": "めんどうに{sp}まきこまれたら{sp}たまらない{p}少年と元城の兵士、そして野育ちの少女。{n}大王が{sp}おってをかけている",
  "en": ""
 },
 {
  "id": "2186_095",
  "hdr": "1203030C",
  "jp": "野育ちで悪かったわね！",
  "en": ""
 },
 {
  "id": "2186_096",
  "hdr": "02030104",
  "jp": "(ジャスミン、だまって！)",
  "en": ""
 },
 {
  "id": "2186_097",
  "hdr": "1A810C14",
  "jp": "やっぱり思ったとおりだ",
  "en": ""
 },
 {
  "id": "2186_098",
  "hdr": "20810C14",
  "jp": "でも、野育ちなんて{n}すてきな生き方だと思うよ",
  "en": ""
 },
 {
  "id": "2186_099",
  "hdr": "1103030C",
  "jp": "………",
  "en": ""
 },
 {
  "id": "2186_100",
  "hdr": "0B030208",
  "jp": "ていあんだが……",
  "en": ""
 },
 {
  "id": "2186_101",
  "hdr": "09030208",
  "jp": "4人づれだと{n}あやしまれないのではないか？",
  "en": ""
 },
 {
  "id": "2186_102",
  "hdr": "1403030C",
  "jp": "もっと良い考えがあるわ。{n}わたしが{sp}ぬければいいのよ{p}男男男女より男男男の方が{n}てきを{sp}あざむきやすいわ",
  "en": ""
 },
 {
  "id": "2186_103",
  "hdr": "02810104",
  "jp": "だめだよ！{sp}きみが{sp}きけんだ！",
  "en": ""
 },
 {
  "id": "2186_104",
  "hdr": "1103030C",
  "jp": "だいじょうぶ。{n}フィリとクリーもいるし",
  "en": ""
 },
 {
  "id": "2186_105",
  "hdr": "01810104",
  "jp": "ぼくたちは仲間だ。別れたくない。{n}いっしょに行こう",
  "en": ""
 },
 {
  "id": "2186_106",
  "hdr": "1103030C",
  "jp": "デインをトーラへ送りとどけるまでよ{p}ケガをさせた{sp}せきにんがあるでしょ？",
  "en": ""
 },
 {
  "id": "2186_107",
  "hdr": "03810104",
  "jp": "ジャスミン……",
  "en": ""
 },
 {
  "id": "2186_108",
  "hdr": "1103030C",
  "jp": "わたしはもう{sp}きめたから。{n}それじゃあ、後で会いましょう！",
  "en": ""
 },
 {
  "id": "2186_109",
  "hdr": "1F810C14",
  "jp": "すまない。ぼくのせいで……",
  "en": ""
 },
 {
  "id": "2186_110",
  "hdr": "09030208",
  "jp": "野育ちをほめられて{n}ちょうしに乗ったのか……",
  "en": ""
 },
 {
  "id": "2186_111",
  "hdr": "03810104",
  "jp": "(ジャスミン、無事でいてくれよ……)",
  "en": ""
 },
 {
  "id": "2186_112",
  "hdr": "20810C14",
  "jp": "ルーカス！",
  "en": ""
 },
 {
  "id": "2186_113",
  "hdr": "3A010660",
  "jp": "これはこれはデインぼっちゃん！{n}おや、ケガをしているんですか？",
  "en": ""
 },
 {
  "id": "2186_114",
